{
  "_comment": "Stack MCP minimo PTVX. Mai path assoluti nel repo: ${PWD} = root progetto al launch. CONTEXT_MODE_DIR: ${PWD}/.claude/context-mode (espanso a path assoluto da Cursor; ~ non espanso). CONTEXT_MODE_EXTERNAL_MCP_NUDGE_EVERY: default 10.",
  "mcpServers": {
    "context-mode": {
      "command": "context-mode",
      "args": [],
      "env": {
        "CONTEXT_MODE_DIR": "${PWD}/.claude/context-mode",
        "CONTEXT_MODE_PROJECT_DIR": "${PWD}",
        "CONTEXT_MODE_EXTERNAL_MCP_NUDGE_EVERY": "10"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp"],
      "env": {}
    },
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"],
      "env": {}
    },
    "token-optimizer": {
      "command": "npx",
      "args": ["-y", "@ooples/token-optimizer-mcp"],
      "env": {
        "TOKEN_OPTIMIZER_CACHE_DIR": "${PWD}/.claude/token-optimizer-cache"
      }
    },
    "laravel-boost": {
      "command": "php",
      "args": ["${PWD}/laravel/artisan", "boost:mcp"],
      "env": {}
    }
  }
}
