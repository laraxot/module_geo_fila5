{
  "version": "1.0",
  "agentManager": {
    "enabled": true,
    "maxAgents": 6,
    "autoCoordination": true,
    "agents": {
      "laravel-architect": {
        "name": "Laravel Architect",
        "model": "gemini-3-pro",
        "type": "development",
        "role": "architect",
        "description": "Architetto specializzato in Laravel 12 e moduli Laraxot",
        "instructions": "Sei un architetto Laravel esperto in moduli Laraxot. Progetta e implementa modelli Eloquent, Actions, API routes, e migrazioni seguendo PHPStan Level 10. Usa pattern XotBase e best practices Laravel 12. Segui sempre il principio 'Fix, Don't Ignore'.",
        "capabilities": [
          "laravel-development",
          "module-architecture",
          "database-design",
          "api-development",
          "phpstan-compliance"
        ],
        "tools": [
          "file-system",
          "terminal",
          "web-browser",
          "database"
        ],
        "permissions": {
          "fileAccess": "read-write",
          "terminal": "execute",
          "network": "read-write",
          "database": "read-write"
        }
      },
      "filament-specialist": {
        "name": "Filament Specialist",
        "model": "gemini-3-pro",
        "type": "development",
        "role": "frontend-architect",
        "description": "Specialista Filament v5 e XotBase per admin panel",
        "instructions": "Sei uno specialista Filament v5. Crea Resources, RelationManager, Widget, e Pages usando pattern XotBase. Non estendere mai classi Filament direttamente. Segui convenzioni Laraxot per admin panels. Usa sempre translation keys, non hardcoded strings.",
        "capabilities": [
          "filament-development",
          "xotbase-patterns",
          "ui-components",
          "form-design",
          "table-components"
        ],
        "tools": [
          "file-system",
          "terminal",
          "web-browser"
        ],
        "permissions": {
          "fileAccess": "read-write",
          "terminal": "execute",
          "network": "read"
        }
      },
      "phpstan-expert": {
        "name": "PHPStan Expert",
        "model": "gemini-3-pro",
        "type": "quality-assurance",
        "role": "code-analyst",
        "description": "Esperto PHPStan Level 10 per code quality",
        "instructions": "Sei un esperto PHPStan Level 10. Analizza codice per errori di tipizzazione, applica strict typing, risolvi mixed types. Segui principio 'Fix, Don't Ignore'. Usa memory limit quando necessario.",
        "capabilities": [
          "static-analysis",
          "type-safety",
          "error-resolution",
          "code-quality",
          "performance-analysis"
        ],
        "tools": [
          "file-system",
          "terminal",
          "code-analyzer"
        ],
        "permissions": {
          "fileAccess": "read-write",
          "terminal": "execute"
        }
      },
      "test-engineer": {
        "name": "Test Engineer",
        "model": "gemini-3-pro",
        "type": "quality-assurance",
        "role": "qa-engineer",
        "description": "Ingegnere dei test specializzato in Pest PHP",
        "instructions": "Sei un ingegnere dei test esperto in Pest PHP. Scrivi test unitari e feature per moduli Laraxot. Esegui test con --coverage e verifica compliance. Usa dati di test realistici.",
        "capabilities": [
          "test-development",
          "pest-php",
          "test-coverage",
          "tdd-practices",
          "quality-assurance"
        ],
        "tools": [
          "file-system",
          "terminal",
          "test-runner"
        ],
        "permissions": {
          "fileAccess": "read-write",
          "terminal": "execute"
        }
      },
      "documentation-writer": {
        "name": "Documentation Writer",
        "model": "gemini-3-flash",
        "type": "creative",
        "role": "technical-writer",
        "description": "Scrittore tecnico per documentazione Laraxot",
        "instructions": "Sei uno scrittore tecnico specializzato in documentazione Laraxot. Aggiorna README.md, docs/ folders, mantieni coerenza standard. Scrivi in italiano chiaro e professionale.",
        "capabilities": [
          "technical-writing",
          "documentation",
          "translation",
          "content-organization",
          "user-guides"
        ],
        "tools": [
          "file-system",
          "text-editor",
          "web-browser"
        ],
        "permissions": {
          "fileAccess": "read-write",
          "network": "read"
        }
      },
      "performance-optimizer": {
        "name": "Performance Optimizer",
        "model": "gemini-3-pro",
        "type": "optimization",
        "role": "performance-engineer",
        "description": "Ottimizzatore performance per applicazioni Laravel",
        "instructions": "Sei un ottimizzatore performance Laravel. Analizza query lente, risolvi N+1, implementa caching Redis, ottimizza asset. Usa Laravel Telescope e debugbar per analisi.",
        "capabilities": [
          "performance-optimization",
          "query-tuning",
          "caching-strategies",
          "asset-optimization",
          "monitoring"
        ],
        "tools": [
          "file-system",
          "terminal",
          "database",
          "profiler"
        ],
        "permissions": {
          "fileAccess": "read-write",
          "terminal": "execute",
          "database": "read-write"
        }
      }
    },
    "workflows": {
      "module-development": {
        "name": "Module Development",
        "description": "Sviluppo completo nuovo modulo Laraxot",
        "agents": ["laravel-architect", "filament-specialist", "test-engineer", "phpstan-expert", "documentation-writer"],
        "coordination": "sequential",
        "steps": [
          {
            "agent": "laravel-architect",
            "task": "Progetta e implementa struttura base modulo",
            "dependencies": [],
            "deliverables": ["modelli", "migrazioni", "actions", "api-routes"]
          },
          {
            "agent": "filament-specialist",
            "task": "Implementa admin resources e UI",
            "dependencies": ["laravel-architect"],
            "deliverables": ["resources", "forms", "tables", "pages"]
          },
          {
            "agent": "test-engineer",
            "task": "Scrivi test completi per il modulo",
            "dependencies": ["laravel-architect", "filament-specialist"],
            "deliverables": ["unit-test", "feature-test", "coverage-report"]
          },
          {
            "agent": "phpstan-expert",
            "task": "Verifica compliance PHPStan Level 10",
            "dependencies": ["laravel-architect", "filament-specialist", "test-engineer"],
            "deliverables": ["phpstan-report", "codice-pulito"]
          },
          {
            "agent": "documentation-writer",
            "task": "Documenta il modulo completamente",
            "dependencies": ["laravel-architect", "filament-specialist", "test-engineer", "phpstan-expert"],
            "deliverables": ["README.md", "docs-completi", "api-documentation"]
          }
        ]
      },
      "bug-fix": {
        "name": "Bug Fix Workflow",
        "description": "Risoluzione bug con testing e verifica",
        "agents": ["laravel-architect", "test-engineer"],
        "coordination": "collaborative"
      },
      "quality-audit": {
        "name": "Quality Audit",
        "description": "Audit completo qualità e performance",
        "agents": ["phpstan-expert", "test-engineer", "performance-optimizer"],
        "coordination": "parallel"
      }
    },
    "skills": {
      "laraxot-module": {
        "name": "Laraxot Module Development",
        "description": "Skill per sviluppo moduli Laraxot compliant",
        "file": "./antigravity/skills/laraxot-module.md"
      },
      "phpstan-level10": {
        "name": "PHPStan Level 10 Compliance",
        "description": "Skill per analisi e fix PHPStan Level 10",
        "file": "./antigravity/skills/phpstan-level10.md"
      },
      "filament-xotbase": {
        "name": "Filament XotBase Patterns",
        "description": "Skill per sviluppo Filament con XotBase",
        "file": "./antigravity/skills/filament-xotbase.md"
      },
      "pest-testing": {
        "name": "Pest PHP Testing",
        "description": "Skill per testing con Pest PHP",
        "file": "./antigravity/skills/pest-testing.md"
      }
    }
  },
  "mcpServers": {
    "laravel": {
      "command": "php",
      "args": ["artisan", "mcp:serve"],
      "cwd": "/var/www/_bases/base_ptvx_fila5_mono",
      "description": "Laravel Artisan commands and framework access"
    },
    "filesystem": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-filesystem", "/var/www/_bases/base_ptvx_fila5_mono"],
      "description": "File system access and operations"
    },
    "database": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-mysql"],
      "env": {
        "MYSQL_HOST": "localhost",
        "MYSQL_USER": "laravel",
        "MYSQL_PASSWORD": "password",
        "MYSQL_DATABASE": "ptvx"
      },
      "description": "MySQL database access and queries"
    },
    "git": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-git", "--repository", "/var/www/_bases/base_ptvx_fila5_mono"],
      "description": "Git version control operations"
    }
  },
  "settings": {
    "autostart": true,
    "autoSave": true,
    "debugMode": false,
    "logLevel": "info",
    "maxTokens": 8192,
    "temperature": 0.1,
    "coordinationTimeout": 300
  }
}