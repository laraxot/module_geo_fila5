.antigravity.*/
.augment/
.bolt/
.claude/
.clauderules/
.clawdbot/
.cline/
.cline.*/
.clinerules/
.clinerules.*/
.codebuddy/
.codex/
.cody/
.commandcode/
.continue/
.crush/
.devcontainer/
.devin/
.factory/
.gemini/
.github~HEAD/
.grok/
.goose/
.iflow/
.junie/
.kilocode/
.kiro/
.lovable/
.mcpjam/
.mux/
.neovate/
.opencode/
.opencode.*/
.openhands/
.phpive/
.pi/
.playcode/
.qoder/
.qwen/
.ralph/
.replit/
.roo/
.tabby/
.tabnine/
.trae/
.vercel/
.vscode/
.windsurf/
.zai/
.zai.*/
.zencoder/

# Skill files AI locali
skills/
skill/

# -----------------------------------------------------------------------------
# 4. LOCK FILES - File di coordinamento (AI Agent)
# Pattern: <filename>.lock per prevenire editing concorrente
# -----------------------------------------------------------------------------
*.lock
!composer.lock
!package-lock.json
!yarn.lock
!pnpm-lock.yaml

# -----------------------------------------------------------------------------
# 5. AMBIENTE & CONFIGURAZIONI LOCALI
# -----------------------------------------------------------------------------
# Environment files
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.testing

# -----------------------------------------------------------------------------
# 6. PHP / COMPOSER - Dipendenze e cache
# -----------------------------------------------------------------------------
/vendor/
vendor/
composer.phar
*.phar

# PHP CS Fixer
.php_cs.cache
.php-cs-fixer.cache

# PHPUnit
.phpunit.result.cache
.phpunit.cache/

# PHPStorm helpers
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php

# Laravel build
laravel/build/
laravel/_ide_helper.php
laravel/_ide_helper_models.php
laravel/.php_cs.cache
laravel/.php-cs-fixer.cache

# -----------------------------------------------------------------------------
# 7. NODE.JS / NPM - Dipendenze e lock files
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------------------------------------------------------
# 8. LARAVEL SPECIFICO
# -----------------------------------------------------------------------------
# Storage e cache
laravel/storage/
laravel/storage/*
laravel/storage/cookie.txt
laravel/bootstrap/cache/*
laravel/bootstrap/cache/modules.php
laravel/stubs/

# Vendor resources (auto-generated)
laravel/resources/lang/vendor/
laravel/resources/views/vendor/
laravel/app/View/Components/vendor/
laravel/lang/vendor/

# Build artifacts
laravel/vite-module-loader.js
laravel/public/build/
laravel/public/hot

# Local config
laravel/config/local/

# -----------------------------------------------------------------------------
# 9. TEMI - Themes/Zero specific
# -----------------------------------------------------------------------------
public_html/storage/
public_html/storage/*
public_html/themes/
public_html/css/
public_html/js/
public_html/vendor/
public_html/plugins/
public_html/fonts/
public_html/material/

# Extras
laravel/Themes/Zero/extras/

# -----------------------------------------------------------------------------
# 10. MODULI - Moduli specifici
# -----------------------------------------------------------------------------
# Moduli deprecati o locali
laravel/Modules/Predict/

# Language auto-generated
laravel/Modules/*/resources/lang/
laravel/Modules/*/lang/lang/

# Docs private
laravel/Modules/*/_docs/

# -----------------------------------------------------------------------------
# 11. ASSETS & BUILD OUTPUT
# -----------------------------------------------------------------------------
/public/build
/public/hot
/public/storage
/public_html/build

# Build directories
build/
dist/
out/

# Cache
/cache/
cache/*
tmp/
tmp*/

# -----------------------------------------------------------------------------
# 12. LOG & TEMP
# -----------------------------------------------------------------------------
*.log
*.log.*
error_log
logs/

# Temp files
*.tmp
*.temp
*.tmp.*

# -----------------------------------------------------------------------------
# 13. BACKUP & ARCHIVI
# -----------------------------------------------------------------------------
*.bak
*.backup
*.backup.*
backups/
*.old
*.old1
*.old2
*_old
*.orig
*.rej
* copy.*
* copy/
*.copy

# Archivi
*.zip
*.tar
*.tar.gz
*.rar
*.7z
*.gz

# Git specific
.git-rewrite/
.git-rewrite
.git-blame-ignore-revs
*.conflict
*.merge
*.rebase

# -----------------------------------------------------------------------------
# 14. DATABASE FILES
# -----------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.sql

# -----------------------------------------------------------------------------
# 15. TEST & COVERAGE
# -----------------------------------------------------------------------------
coverage/
coverage.xml/
.nyc_output/
junit.xml
test-output/

# -----------------------------------------------------------------------------
# 16. BINARY & ESEGUIBILI
# -----------------------------------------------------------------------------
*.exe
*.out
*.app
*.dll
*.so
*.dylib
*.jar

# -----------------------------------------------------------------------------
# 17. FILE SPECIFICI PROGETTO
# -----------------------------------------------------------------------------
# Backup GitHub
.github.backup-*/

# Templates
/templates/

# Configurazioni locali
laravel/config/local/tv/prov/personale2022/database/content/information_schema_tables.json
laravel/config/local/ptvx/database/content/information_schema_tables.json

# File di test
* - Copia.php
test*.php

# Scripts bash locali
bashscripts/

# Copy files (duplicati temporanei)
* copy
* copy.*
*.copy
*~

# Altri
laravel/nunomaduro-phpinsights-ae780a9/
laravel/phpinsights-standalone
dump.rdb

