# =============================================================================
# .gitignore - Laraxot PTVX Project
# =============================================================================
# ATTENZIONE: Questo file DEVE rimanere organizzato per categorie.
# Non aggiungere pattern duplicati - verificare prima di modificare.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SISTEMA OPERATIVO - File di sistema e metadata
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.lnk

# Linux/Unix
.fuse_hidden*
.directory

# Windows
*:Zone.Identifier
*.Zone.Identifier
**/*.Zone.Identifier

# -----------------------------------------------------------------------------
# 2. EDITOR & IDE - Configurazioni locali
# -----------------------------------------------------------------------------
# VSCode
.vscode/
.vscode-test/
.history/

# JetBrains (PhpStorm, WebStorm, IntelliJ)
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Eclipse
.project
.classpath
.settings/

# Vim/Neovim
*.swp
*.swo
*.swn
*~
.~*

# Emacs
*~
\#*\#
\.\#*

# Altri editor
*.tmproj

# -----------------------------------------------------------------------------
