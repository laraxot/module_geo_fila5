{
  "mode": "yolo",
  "granularity": "fine",
  "parallelization": true,
  "commit_docs": true,
  "model_profile": "quality",
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": true
  },
  "git": {
    "branching_strategy": "none",
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "gsd/{milestone}-{slug}"
  },
  "hooks": {
    "context_warnings": true,
    "post_execute_phpstan": true,
    "post_execute_pint": true
  },
  "laraxot": {
    "phpstan_level": 10,
    "strict_types": true,
    "no_filament_labels": true,
    "xotbase_required": true,
    "no_property_exists": true,
    "no_migration_down": true,
    "expanded_translations": true
  },
  "_auto_chain_active": true
}
