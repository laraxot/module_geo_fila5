{
  "mcpServers": {
    "laravel-boost": {
      "command": "/usr/bin/php8.3",
      "args": [
        "${PWD}/laravel/artisan",
        "boost:mcp"
      ]
    },
    "qmd": {
      "command": "qmd",
      "args": [
        "mcp"
      ],
      "env": {}
    },
    "token-optimizer": {
      "command": "${PWD}/bashscripts/mcp/node_modules/.bin/token-optimizer-mcp",
      "args": [],
      "env": {
        "TOKEN_OPTIMIZER_CACHE_DIR": "${PWD}/.claude/token-optimizer-cache"
      }
    }
  }
}
