includes:
    #- ./phpstan-baseline.neon
    - ./vendor/larastan/larastan/extension.neon
    - ./vendor/nesbot/carbon/extension.neon
    - ./vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - ./vendor/thecodingmachine/phpstan-safe-rule/phpstan-safe-rule.neon
    - ./vendor/pestphp/pest/extension.neon

parameters:

    paths:
        - Modules
        #- Themes

    level: max

    ignoreErrors:
        #   message: '#PHPDoc tag @mixin contains unknown class Modules\\Badge\\Models\\IdeHelper(.*)+\\.'
        # - '#No error to ignore is reported on line#'
        # Removed: unmatched ignores causing phpstan warnings
        - '#PHPDoc tag @mixin contains unknown class #'
        - '#Static call to instance method Nwidart#'
        - '#Cannot cast mixed to (string|float|double|int|bool|boolean).#' # Ignora errori di cast da mixed a tipi specifici
        - identifier: missingType.iterableValue
        - identifier: missingType.generics
        - identifier: larastan.noEnvCallsOutsideOfConfig
        - identifier: trait.unused
        - identifier: method.unused
        # OauthClient::user() return type - Laraxot compatibility (XotData::getUserClass() vs Passport)
        - { message: '#Return type .*OauthClient::user\(\).*should be compatible with.*Laravel\\Passport\\Client::user\(\)#', identifier: method.childReturnType }
        # Eloquent relation covariance: BelongsToMany, HasOne, BelongsTo template params are not covariant
        # This is a known limitation of Laravel's type system and is not a real bug
        - identifier: return.type
          message: '#(BelongsToMany|HasOne|BelongsTo|Pivot|covariant)#'
        - identifier: method.childReturnType
          message: '#(BelongsToMany|HasOne|BelongsTo|Pivot|covariant)#'
        # Classes from optional/external modules (not installed in this environment)
        - identifier: class.notFound
          message: '#Modules\\(Cms|Comment|Geo|Badge|Timbra)\\#'

    excludePaths:
        - ./*/vendor/*
        - ./*/Tests/*
        - ./*/tests/*
        - ./*/build/*
        - ./*/docs/*
        - ./*/Main_files/*
        - ./*/phpinsights.php
        - ./*/rector.php
        - ./*/*.blade.php
        #- ./config/local/*/database.php
        # Moduli in ordine alfabetico:
        #- ./Modules/Activity/*
        #- ./Modules/Badge/*
        #- ./Modules/CertFisc/*
        #- ./Modules/ContoAnnuale/*
        #- ./Modules/DbForge/*
        #- ./Modules/Europa/*
        #- ./Modules/Gdpr/*
        #- ./Modules/Inail/*
        #- ./Modules/Incentivi/*
        #- ./Modules/IndennitaCondizioniLavoro/*
        #- ./Modules/IndennitaResponsabilita/*
        #- ./Modules/Job/*
        #- ./Modules/Lang/*
        #- ./Modules/Legge104/*
        #- ./Modules/Legge109/*
        #- ./Modules/Media/*
        #- ./Modules/Mensa/*
        #- ./Modules/MobilitaVolontaria/*
        #- ./Modules/Notify/*
        #- ./Modules/Pdnd/*
        #- ./Modules/Performance/*
        #- ./Modules/Prenotazioni/*
        #- ./Modules/PresenzeAssenze/*
        #- ./Modules/Progressioni/*
        # - ./Modules/Ptv/*
        #- ./Modules/Questionari/*
        #- ./Modules/Rating/*
        #- ./Modules/Setting/*
        #- ./Modules/Sigma/*
        #- ./Modules/Sindacati/*
        #- ./Modules/Tenant/*
        #- ./Modules/UI/*
        #- ./Modules/User/*
        #- ./Modules/Xot/*

    bootstrapFiles:
        - ./phpstan_constants.php
        - ./phpstan-bootstrap.php
        # Removed OAuthenticatable stub - conflicts with real Passport interface
        #- ./phpstan-stubs/OAuthenticatable.php
        #- ./vendor/amenadiel/jpgraph/src/config.inc.php

    scanFiles:
        - ./Modules/Xot/helpers/Helper.php

    mixinExcludeClasses:
        - ./Modules/Badge/Models
        - IdeHelperTimbra

    editorUrl: 'vscode://file/%%file%%:%%line%%'

    tmpDir: /tmp/phpstan/
    # Disable parallel processing to avoid memory issues

    noUnnecessaryCollectionCall: false
    checkUnusedViews: false
    checkModelProperties: false
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    checkOctaneCompatibility: false
