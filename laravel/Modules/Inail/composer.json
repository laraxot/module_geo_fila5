{
    "name": "laraxot/module_inail_fila5",
    "description": "INAIL workplace insurance module for the Laraxot ecosystem: work injuries, occupational diseases, and insurance claims management.",
    "keywords": [
        "laraxot",
        "laravel",
        "filament",
        "module_inail",
        "inail",
        "workplace-insurance",
        "work-injuries",
        "occupational-health",
        "hr"
    ],
    "license": "MIT",
    "homepage": "https://github.com/laraxot/module_inail_fila5.git",
    "authors": [
        {
            "name": "Marco Sottana",
            "email": "marco.sottana@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {},
    "repositories": [
        {
            "type": "path",
            "url": "../Xot"
        },
        {
            "type": "path",
            "url": "../Tenant"
        },
        {
            "type": "path",
            "url": "../UI"
        }
    ],
    "autoload": {
        "psr-4": {
            "Modules\\Inail\\": "app/",
            "Modules\\Inail\\Database\\Factories\\": "database/factories/",
            "Modules\\Inail\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [],
        "post-update-cmd": [],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "./vendor/bin/pest --no-coverage",
        "test-coverage": "vendor/bin/pest --coverage-html coverage",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Inail\\Providers\\InailServiceProvider",
                "Modules\\Inail\\Providers\\Filament\\AdminPanelProvider"
            ],
            "aliases": {}
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Modules\\Inail\\Tests\\": "tests/"
        }
    }
}
