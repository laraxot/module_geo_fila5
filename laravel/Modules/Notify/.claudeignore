# Vendor e dipendenze (grandi, generate, non utili al context)
vendor/
node_modules/
**/vendor/
**/node_modules/

# Build artifacts
public/build/
public/hot/
laravel/public/themes/*/assets/
laravel/Themes/*/public/

# Storage e cache
storage/
.phpunit.cache/
*.cache
bootstrap/cache/

# Lock files (grandi, deterministici)
composer.lock
package-lock.json
yarn.lock

# Binary e media
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
*.woff
*.woff2
*.ttf
*.eot
*.map

# DB file (usare MCP sqlite per query dirette)
*.sqlite
*.sqlite3

# Log
*.log
# Additional large documentation directories
laravel/Modules/**/docs/**
docs/**/*.md
# Git metadata
.git/
*.log
