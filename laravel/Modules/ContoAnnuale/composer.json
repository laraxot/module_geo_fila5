{
  "name": "laraxot/module_contoannuale_fila3",
  "description": "Annual financial report (Conto Annuale) module for the Laraxot ecosystem: public administration HR cost reporting to RGS/MEF.",
  "keywords": [
    "laraxot",
    "laravel",
    "filament",
    "module_contoannuale",
    "conto-annuale",
    "public-administration",
    "rgs",
    "hr-reporting",
    "mef"
  ],
  "license": "MIT",
  "homepage": "https://github.com/laraxot/module_contoannuale_fila3.git",
  "authors": [
    {
      "name": "Marco Sottana",
      "email": "marco.sottana@gmail.com"
    }
  ],
  "require": {},
  "require-dev": {},
  "repositories": [
    {
      "type": "path",
      "url": "../Xot"
    },
    {
      "type": "path",
      "url": "../Tenant"
    },
    {
      "type": "path",
      "url": "../UI"
    }
  ],
  "autoload": {
    "psr-4": {
      "Modules\\ContoAnnuale\\": "app/",
      "Modules\\ContoAnnuale\\Database\\Factories\\": "database/factories/",
      "Modules\\ContoAnnuale\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": [],
    "post-update-cmd": [],
    "analyse": "vendor/bin/phpstan analyse",
    "test": "./vendor/bin/pest --no-coverage",
    "test-coverage": "vendor/bin/pest --coverage-html coverage",
    "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true,
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Modules\\ContoAnnuale\\Providers\\ContoAnnualeServiceProvider",
        "Modules\\ContoAnnuale\\Providers\\Filament\\AdminPanelProvider"
      ],
      "aliases": {}
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload-dev": {
    "psr-4": {
      "Modules\\ContoAnnuale\\Tests\\": "tests/"
    }
  }
}
