{
  "name": "laraxot/module_mobilitavolontaria_fila3",
  "description": "Voluntary employee mobility module for the Laraxot ecosystem: transfer requests, inter-agency mobility, and relocation management.",
  "keywords": [
    "laraxot",
    "laravel",
    "filament",
    "module_mobilitavolontaria",
    "employee-transfer",
    "mobility",
    "relocation",
    "public-administration",
    "hr"
  ],
  "license": "MIT",
  "homepage": "https://github.com/laraxot/module_mobilitavolontaria_fila3.git",
  "authors": [
    {
      "name": "Marco Sottana",
      "email": "marco.sottana@gmail.com"
    }
  ],
  "require": {
    "spatie/laravel-sluggable": "*"
  },
  "require-dev": {},
  "repositories": [
    {
      "type": "path",
      "url": "../Xot"
    },
    {
      "type": "path",
      "url": "../Tenant"
    },
    {
      "type": "path",
      "url": "../UI"
    }
  ],
  "autoload": {
    "psr-4": {
      "Modules\\MobilitaVolontaria\\": "app/",
      "Modules\\MobilitaVolontaria\\Database\\Factories\\": "database/factories/",
      "Modules\\MobilitaVolontaria\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": [],
    "post-update-cmd": [],
    "analyse": "vendor/bin/phpstan analyse",
    "test": "./vendor/bin/pest --no-coverage",
    "test-coverage": "vendor/bin/pest --coverage-html coverage",
    "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true,
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Modules\\MobilitaVolontaria\\Providers\\MobilitaVolontariaServiceProvider",
        "Modules\\MobilitaVolontaria\\Providers\\Filament\\AdminPanelProvider"
      ],
      "aliases": {}
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload-dev": {
    "psr-4": {
      "Modules\\MobilitaVolontaria\\Tests\\": "tests/"
    }
  }
}
