     */
    public function criteriOptionsArr(string $name): mixed
    {
        $res = $this->criteriOptions->where('name', $name)->first();
        if (isset($res->type) && 'date' === $res->type && isset($res->value) && null !== $res->value) {
            $res->value = Carbon::parse($res->value);
        }

        return $res?->value;
    }
