{
  "name": "laraxot/module_legge109_fila5",
  "description": "Law 109 public works and procurement module for the Laraxot ecosystem: incentive fees, technical staff compensation, and project management.",
  "keywords": [
    "laraxot",
    "laravel",
    "filament",
    "module_legge109",
    "legge109",
    "public-works",
    "procurement",
    "incentive-fees",
    "hr"
  ],
  "license": "MIT",
  "homepage": "https://github.com/laraxot/module_legge109_fila5.git",
  "authors": [
    {
      "name": "Marco Sottana",
      "email": "marco.sottana@gmail.com"
    }
  ],
  "require": {},
  "require-dev": {},
  "repositories": [
    {
      "type": "path",
      "url": "../Xot"
    },
    {
      "type": "path",
      "url": "../Tenant"
    },
    {
      "type": "path",
      "url": "../UI"
    }
  ],
  "autoload": {
    "psr-4": {
      "Modules\\Legge109\\": "app/",
      "Modules\\Legge109\\Database\\Factories\\": "database/factories/",
      "Modules\\Legge109\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": [],
    "post-update-cmd": [],
    "analyse": "vendor/bin/phpstan analyse",
    "test": "./vendor/bin/pest --no-coverage",
    "test-coverage": "vendor/bin/pest --coverage-html coverage",
    "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true,
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Modules\\Legge109\\Providers\\Legge109ServiceProvider",
        "Modules\\Legge109\\Providers\\Filament\\AdminPanelProvider"
      ],
      "aliases": {}
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload-dev": {
    "psr-4": {
      "Modules\\Legge109\\Tests\\": "tests/"
    }
  }
}
