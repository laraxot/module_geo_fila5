{
    "name": "provtv/module_europa_fila5",
    "description": "European funds and projects management module for the Laraxot ecosystem: EU funding programs, PNRR, and structural funds tracking.",
    "keywords": [
        "laraxot",
        "laravel",
        "filament",
        "module_europa",
        "eu-funds",
        "pnrr",
        "european-projects",
        "structural-funds",
        "public-administration"
    ],
    "license": "MIT",
    "homepage": "https://github.com/provtv/module_europa_fila5.git",
    "authors": [
        {
            "name": "Marco Sottana",
            "email": "marco.sottana@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {},
    "repositories": [
        {
            "type": "path",
            "url": "../Xot"
        },
        {
            "type": "path",
            "url": "../Tenant"
        },
        {
            "type": "path",
            "url": "../UI"
        }
    ],
    "autoload": {
        "psr-4": {
            "Modules\\Europa\\": "app/",
            "Modules\\Europa\\Database\\Factories\\": "database/factories/",
            "Modules\\Europa\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [],
        "post-update-cmd": [],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "./vendor/bin/pest --no-coverage",
        "test-coverage": "vendor/bin/pest --coverage-html coverage",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Europa\\Providers\\EuropaServiceProvider",
                "Modules\\Europa\\Providers\\Filament\\AdminPanelProvider"
            ],
            "aliases": {}
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Modules\\Europa\\Tests\\": "tests/"
        }
    }
}
