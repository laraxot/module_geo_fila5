<?php

declare(strict_types=1);

namespace Modules\Ptv\Filament\Tables\Columns;

use Filament\Tables\Columns\TextColumn;
use Modules\UI\Filament\Tables\Columns\GroupColumn;

class ValutatoreColumn extends GroupColumn
{
    protected function setUp(): void
    {
        parent::setUp();

        // Pre-configure the schema with valutatore fields
        $this->schema([
            TextColumn::make('valutatore.nome_diri')
                ->label('Nome Valutatore')
                ->searchable(),
            TextColumn::make('valutatore.nome_diri_plus')
                ->label('Nome Completo')
                ->searchable(),
        ])->searchable(['valutatore.nome_diri', 'valutatore.nome_diri_plus']);
    }
}