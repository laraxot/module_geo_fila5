<?php

declare(strict_types=1);

use function Safe\file_get_contents;
use function Safe\file_put_contents;

/**
 * Script per correggere tutte le Factory del modulo Progressioni
 * Sostituisce i metodi Faker non esistenti con quelli corretti
 */
$factories = [
    'CriteriEsclusioneFactory.php',
    'CriteriOptionFactory.php',
    'CriteriValutazioneFactory.php',
    'EsclusiExtraFactory.php',
    'MessageFactory.php',
    'MyLogFactory.php',
    'PesiFactory.php',
    'ProgressioniFactory.php',
    'SchedaCriteriFactory.php',
    'SchedaFactory.php',
    'StabiDirigenteFactory.php',
    'StipendioTabellareFactory.php',
    'ValutatoreFactory.php',
];

$replacements = [
    '$this->faker->randomNumber' => '$this->faker->numberBetween(1, 1000)',
    '$this->faker->randomFloat' => '$this->faker->randomFloat(2, 0, 100)',
    '$this->faker->integer' => '$this->faker->numberBetween(1, 100)',
    '$this->faker->word' => '$this->faker->word()',
    '$this->faker->name' => '$this->faker->name()',
    '$this->faker->email' => '$this->faker->email()',
    '$this->faker->sentence' => '$this->faker->sentence()',
    '$this->faker->text' => '$this->faker->text()',
];

foreach ($factories as $factory) {
    $filePath = __DIR__.'/database/Factories/'.$factory;

    if (! file_exists($filePath)) {
        echo "File not found: $factory\n";

        continue;
    }

    $content = file_get_contents($filePath);

    // Applica le sostituzioni
    foreach ($replacements as $search => $replace) {
        $content = str_replace($search, $replace, $content);
    }

    // Aggiungi return type al metodo definition se manca
    if (strpos($content, '@return array<string, mixed>') === false) {
        $content = str_replace(
            'public function definition(): array',
            'public function definition(): array',
            $content
        );

        // Aggiungi PHPDoc se manca
        if (strpos($content, '/**') === false || strpos($content, '@return array<string, mixed>') === false) {
            $content = str_replace(
                'public function definition(): array',
                "    /**\n     * Define the model's default state.\n     *\n     * @return array<string, mixed>\n     */\n    public function definition(): array",
                $content
            );
        }
    }

    file_put_contents($filePath, $content);
    echo "Fixed: $factory\n";
}

echo "All factories fixed!\n";
